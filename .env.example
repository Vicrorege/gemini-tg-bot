# Telegram Bot Configuration
# Получите токен у @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Прокси для Telegram API (опционально, если Telegram заблокирован):
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080

# Белый список Telegram ID через запятую (узнать свой ID: @userinfobot)
# Если оставить пустым, бот будет доступен всем
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Antigravity / Gemini API Backend (OpenAI-совместимый эндпоинт)
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=your_api_key_here

# Модели
DEFAULT_MODEL=agy/gemini-3.7-flash-high
ROUTER_MODEL=agy/gemini-2.5-flash
# Доступные для выбора пользователем модели через запятую
AVAILABLE_MODELS=agy/gemini-3.7-flash-high,agy/gemini-3.1-pro-high

# Web Search & Internet Intelligence
WEB_SEARCH_ENABLED=true
MAX_SEARCH_RESULTS=5
WEB_FETCH_TIMEOUT=8.0
DEFAULT_WEB_MODE=auto

# Context Compression & Limits
# Порог токенов для автоматического сжатия истории
MAX_CONTEXT_TOKENS=32000
# Количество последних сообщений, защищенных от сжатия
PROTECT_LAST_N_MESSAGES=6

# Интервал обновления сообщений при стриминге (сек)
STREAM_UPDATE_INTERVAL=0.8

# Системный промпт по умолчанию
SYSTEM_PROMPT=You are an intelligent, helpful, and concise AI assistant powered by Gemini. You format answers nicely using Telegram Markdown, explain complex concepts clearly, and adapt to the user's language and tone.

# SQLite Database path
DB_PATH=data/bot.db
